@using CarCareTracker.Helper
@inject IConfigHelper config
@inject ITranslationHelper translator
@model List<OdometerRecord>
@{
    var userConfig = config.GetUserConfig(User);
    var userLanguage = userConfig.UserLanguage;
}
<div id="odometerHistoryModalContainer" class="d-none">
    <div class="modal-header">
        <h5 class="modal-title">@translator.Translate(userLanguage, "Odometer History")</h5>
    </div>
    <div class="modal-body">
        @if (Model.Any())
        {
            <div class="row">
                <div class="col-12" style="max-height:50vh; overflow-y:auto;">
                    <div class="d-flex flex-column">
                        @foreach (OdometerRecord odometerHistory in Model)
                        {
                            <div class="d-flex align-items-center p-2 border rounded mb-2 flex-nowrap">
                                <div class="d-flex flex-column flex-grow-1">
                                    <small>@StaticHelper.TruncateStrings(odometerHistory.Date.ToShortDateString())</small>
                                    <div class="d-flex flex-row gap-2 flex-wrap">
                                        <div class="d-flex flex-column text-wrap break-all">
                                            <small class="text-secondary">@translator.Translate(userLanguage, "Initial Odometer")</small>
                                            <small>@odometerHistory.InitialMileage</small>
                                        </div>
                                        <div class="d-flex flex-column text-wrap break-all">
                                            <small class="text-secondary">@translator.Translate(userLanguage, "Odometer")</small>
                                            <small>@odometerHistory.Mileage</small>
                                        </div>
                                        <div class="d-flex flex-column text-wrap break-all">
                                            <small class="text-secondary">@translator.Translate(userLanguage, "Distance")</small>
                                            <small>@(odometerHistory.DistanceTraveled == default ? "---" : odometerHistory.DistanceTraveled)</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center flex-column">
                                    <button onclick="loadRecordAttachment(@odometerHistory.Id, 'OdometerRecord')" class="btn btn-outline-secondary btn-md mt-1 mb-1"><i class="bi bi-box-arrow-in-up-right"></i></button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="row">
                <div class="col-12">
                    <div class="text-center">
                        <h4>@translator.Translate(userLanguage, "No odometer history")</h4>
                    </div>
                </div>
            </div>
        }
    </div>
</div>